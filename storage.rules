rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    // Same passcodeVerified/isAdmin custom claims checked in firestore.rules
    // (set only by the verifyPasscode/claimAdmin Cloud Functions) — read
    // straight off the auth token, no cross-service Firestore lookup needed.
    // A plain browser visit never signs in, so it never reaches past
    // isSignedIn() here.
    function isMember() {
      return isSignedIn() && request.auth.token.passcodeVerified == true;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.isAdmin == true;
    }
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Item photo strips also accept short video clips now — capped higher
    // than a photo since even a few seconds of phone video runs well past
    // 10MB, but still bounded to keep this free-tier-friendly.
    function isValidMedia() {
      return request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /beers/{beerId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
    match /spirits/{spiritId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
    match /nikotin/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
    match /koffein/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
    match /users/{userId}/{fileName} {
      allow read: if true;
      // A profile photo stays image-only — this path is never a video.
      allow create, update: if isMember() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isMember() && (request.auth.uid == userId || isAdmin());
    }
    match /parties/{partyId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
    match /pubs/{pubId}/{fileName} {
      allow read: if true;
      allow create, update: if isMember() && isValidMedia();
      allow delete: if isMember();
    }
  }
}
